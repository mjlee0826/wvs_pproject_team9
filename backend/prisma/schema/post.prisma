model Post {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  imageUrl  String?
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  comments  Comment[]
  likes     Like[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
